/* ==================== 功能导航页 ==================== */

.home-page {
  background: var(--gradient-page);
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #ECFDF5;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-card);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 8rpx rgba(16,185,129,0.4);
  animation: statusBlink 2s ease-in-out infinite;
}

@keyframes statusBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.status-label {
  font-size: 24rpx;
  color: var(--color-success-light);
  font-weight: 600;
}

.device-badge {
  background: #F1F5F9;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-xs);
}

.badge-text {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 欢迎区 */
.welcome-area {
  margin-bottom: 40rpx;
}

.welcome-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.welcome-desc {
  display: block;
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 功能宫格 */
.feature-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.feature-card {
  background: var(--text-white);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.03);
  border: 1rpx solid #F1F5F9;
  transition: all 0.2s;
}

.feature-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(79,70,229,0.1);
  border-color: #DDD6FE;
}

.feature-bg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.monitor-bg { background: linear-gradient(135deg, #EEF2FF, #DDD6FE); }
.scene-bg { background: linear-gradient(135deg, #FEF3C7, #FDE68A); }
.control-bg { background: linear-gradient(135deg, #D1FAE5, #A7F3D0); }

.feature-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-xs);
  background: var(--text-white);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.feature-icon {
  font-size: 32rpx;
}

.feature-info {
  flex: 1;
}

.feature-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
}

.feature-arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F8FAFC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-arrow text {
  font-size: 36rpx;
  color: var(--text-muted);
  font-weight: 300;
  margin-top: -2rpx;
}

/* 断开连接 */
.disconnect-area {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.disconnect-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  background: var(--text-white);
  border-radius: var(--radius-round);
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.disconnect-btn:active {
  background: #FEF2F2;
  border-color: #FECACA;
}

.disconnect-icon {
  font-size: 28rpx;
}

.disconnect-text {
  font-size: 28rpx;
  color: var(--text-sub);
  font-weight: 500;
}

/* 底部 */
.footer-brand {
  text-align: center;
  padding: 24rpx;
}

.footer-brand text {
  font-size: 22rpx;
  color: var(--text-muted);
}
