/* ==================== 场景模式页 — Glassmorphism ==================== */

.scene-page {
  background: var(--gradient-page);
  padding-bottom: 48rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--text-hint);
  margin-bottom: 24rpx;
}

/* 设备模式同步条 */
.device-mode-bar {
  margin-bottom: 24rpx;
  padding: 18rpx 28rpx;
  border-radius: var(--radius-sm);
}

.mode-bar-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mode-bar-icon {
  font-size: 26rpx;
}

.mode-bar-label {
  font-size: 24rpx;
  color: var(--text-hint);
}

.mode-bar-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* 分区标题 */
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

/* 模式卡片列表 */
.mode-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.mode-card {
  border-radius: var(--radius-card);
  padding: 24rpx 24rpx;
  display: flex;
  align-items: center;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.mode-card:active {
  transform: scale(0.98);
}

/* 选中态 */
.mode-card.sleep-active { border-color: var(--color-info); background: rgba(59, 130, 246, 0.05); box-shadow: 0 6rpx 24rpx rgba(59, 130, 246, 0.12); }
.mode-card.study-active { border-color: var(--color-warning); background: rgba(245, 158, 11, 0.05); box-shadow: 0 6rpx 24rpx rgba(245, 158, 11, 0.12); }
.mode-card.rest-active  { border-color: #8B5CF6; background: rgba(139, 92, 246, 0.05); box-shadow: 0 6rpx 24rpx rgba(139, 92, 246, 0.12); }

.mode-card.normal-active { border-color: var(--text-sub); background: rgba(100, 116, 139, 0.04); box-shadow: 0 6rpx 24rpx rgba(100, 116, 139, 0.12); }
.mode-card.eco-active    { border-color: #06B6D4; background: rgba(6, 182, 212, 0.05); box-shadow: 0 6rpx 24rpx rgba(6, 182, 212, 0.12); }
.mode-card.safe-active   { border-color: var(--color-danger); background: rgba(239, 68, 68, 0.04); box-shadow: 0 6rpx 24rpx rgba(239, 68, 68, 0.12); }

.mode-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.sleep-box  { background: #DBEAFE; }
.study-box  { background: #FEF3C7; }
.rest-box   { background: #EDE9FE; }
.normal-box { background: #F1F5F9; }
.eco-box    { background: #CFFAFE; }
.safe-box   { background: #FEE2E2; }

.mode-icon { font-size: 34rpx; }

.mode-content {
  flex: 1;
  min-width: 0;
}

.mode-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.mode-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 命令提示 */
.mode-cmd {
  font-size: 20rpx;
  color: var(--text-muted);
  font-family: monospace;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 选中指示器 */
.mode-indicator {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  animation: checkIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes checkIn {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.mode-indicator text {
  font-size: 26rpx;
  color: var(--text-white);
  font-weight: 700;
}

/* 底部提示 */
.scene-footer {
  text-align: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-muted);
}
